  {
    "@id": "https://w3id.org/rec#Architecture",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "Alignment bridge required for pyshacl validation. Brick 1.4's bsh:isPointOfShape has two sh:or constraints that both must pass: one allows (brick:Equipment | brick:Location) and another allows (brick:Equipment | brick:Location | rec:Space). Spaces typed as rec:Room/rec:Office/etc. satisfy the second constraint transitively via rec:Room→rec:Architecture→rec:Space, but fail the first unless rec:Architecture is declared a subclass of brick:Location. This is semantically sound: brick:Location is Brick's class for quantifiable physical locations, which is exactly what rec:Architecture defines. Brick.ttl itself maps brick:Location owl:equivalentProperty rec:isPointOf and uses rec:Space as a parent of brick:Location, making this bridge an extension of the existing Brick-REC alignment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://brickschema.org/schema/Brick#Location"
      }
    ]
  },
