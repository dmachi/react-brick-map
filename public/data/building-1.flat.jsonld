  {
    "@id": "urn:demo:point:ccspace-room-3-co2",
    "@type": [
      "https://brickschema.org/schema/Brick#Point"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Room 3 CO2"
